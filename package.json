{
  "name": "chrome-extension",
  "description": "Publish extension to Chrome Web Store.",
  "version": "2.0.0",
  "author": "hyperbola",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wdzeng/chrome-extension"
  },
  "license": "MIT",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm transpile && cp action.yml dist",
    "transpile": "esbuild src/index.ts --platform=node --target=node24 --minify --bundle --outfile=dist/index.cjs",
    "test": "pnpm test-publish-new-version",
    "test-publish-new-version": "node -r dotenv/config test/publish-new-version.ts dotenv_config_path=.env.local",
    "renew-credentials": "node -r dotenv/config ci/renew-credentials.ts dotenv_config_path=.env.local",
    "lint": "eslint --fix src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "axios": "^1.17.0",
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "@types/node": "^24.13.1",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "eslint-config-wdzeng": "github:wdzeng/eslint-config#semver:^0.16.0",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "node": ">=24"
  }
}
