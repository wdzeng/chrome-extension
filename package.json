{
  "name": "chrome-extension",
  "description": "Publish to the Chrome Web Store.",
  "version": "1.3.2",
  "author": "hyperbola",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wdzeng/chrome-extension"
  },
  "license": "MIT",
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "scripts": {
    "test": "pnpm test-publish-new-version",
    "test-publish-new-version": "node -r dotenv/config test/publish-new-version.ts dotenv_config_path=.env.local",
    "ci-renew-credentials": "node -r dotenv/config ci/renew-credentials.ts dotenv_config_path=.env.local",
    "lint": "eslint --fix src test"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "axios": "^1.17.0",
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "@types/node": "^24.13.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.1",
    "eslint-config-wdzeng": "github:wdzeng/eslint-config#semver:^0.16.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "^24"
  }
}
