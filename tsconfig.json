{
  "include": ["src/**/*.ts", "test/**/*.ts", "ci/**/*.ts"],
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "esnext",
    "types": ["node"],

    "noEmit": true,
    "module": "nodenext",
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "skipLibCheck": true,

    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,

    "allowJs": false,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  }
}
